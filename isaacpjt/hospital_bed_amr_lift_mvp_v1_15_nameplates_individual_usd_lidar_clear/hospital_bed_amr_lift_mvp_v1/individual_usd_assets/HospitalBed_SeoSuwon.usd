    def Scope "Looks"
    {
        def Material "NameplateOmniPBR"
        {
            token outputs:mdl:surface.connect = </HospitalBed_SeoSuwon/Looks/NameplateOmniPBR/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                asset inputs:diffuse_texture = @./textures/nameplate_seo_suwon.png@
                color3f inputs:diffuse_color_constant = (1, 1, 1)
                float inputs:roughness_constant = 0.35
                float inputs:metallic_constant = 0
                bool inputs:project_uvw = 0
                token outputs:out
            }
        }
