#usda 1.0
(
    defaultPrim = "AssetPreview"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "AssetPreview"
{
    def Xform "AMR1" (
        prepend references = @./AMR1.usd@
    )
    {
        double3 xformOp:translate = (-2, -1.5, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "AMR2" (
        prepend references = @./AMR2.usd@
    )
    {
        double3 xformOp:translate = (-2, 1.5, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "BedSeoSuwon" (
        prepend references = @./HospitalBed_SeoSuwon.usd@
    )
    {
        double3 xformOp:translate = (1, -2, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "BedKimSeoul" (
        prepend references = @./HospitalBed_KimSeoul.usd@
    )
    {
        double3 xformOp:translate = (1, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "BedParkIncheon" (
        prepend references = @./HospitalBed_ParkIncheon.usd@
    )
    {
        double3 xformOp:translate = (1, 2, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
