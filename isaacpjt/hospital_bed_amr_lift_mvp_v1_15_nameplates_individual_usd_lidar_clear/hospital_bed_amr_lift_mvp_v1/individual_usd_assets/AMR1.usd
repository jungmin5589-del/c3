    def Xform "Joints"
    {
        def PhysicsRevoluteJoint "wheel_joint_FL" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            rel physics:body0 = </AMR1/base_link>
            rel physics:body1 = </AMR1/wheel_FL>
            uniform token physics:axis = "Y"
            point3f physics:localPos0 = (0.3, 0.2825, -0.01)
            quatf physics:localRot0 = (1, 0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            bool physics:collisionEnabled = 0
            uniform token drive:angular:physics:type = "force"
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:damping = 1800
            float drive:angular:physics:maxForce = 2500
            float drive:angular:physics:targetVelocity = 0
            custom float isaacmecanumwheel:radius = 0.075
            custom float isaacmecanumwheel:angle = 0.7853981633974483
        }
