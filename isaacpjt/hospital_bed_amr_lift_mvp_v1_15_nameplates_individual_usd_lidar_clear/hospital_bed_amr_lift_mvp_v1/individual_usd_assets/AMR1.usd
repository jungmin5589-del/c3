#usda 1.0
(
    defaultPrim = "AMR1"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "AMR1" (
    kind = "component"
    prepend apiSchemas = ["PhysicsArticulationRootAPI"]
)
{
    custom string hospitalBedAMR:version = "v1.15"
    custom string hospitalBedAMR:namespace = "amr1"
    custom string hospitalBedAMR:lidarConfig = "Example_Rotary_2D"
    custom string hospitalBedAMR:lidarClearance = "scan plane clear; housing top 0.03 m below lidar_link"

    def Xform "base_link" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
    )
    {
        bool physics:rigidBodyEnabled = 1
        bool physics:kinematicEnabled = 0
        float physics:mass = 80
        bool physxRigidBody:enableCCD = 1
        double3 xformOp:translate = (0, 0, 0.085)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "Chassis" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
        {
            double size = 1
            double3 xformOp:translate = (0, 0, 0)
            float3 xformOp:scale = (0.8, 0.52, 0.08)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            color3f[] primvars:displayColor = [(0.08, 0.3, 0.62)]
        }

        def Cube "LidarPedestal"
        {
            double size = 1
            double3 xformOp:translate = (0, 0, 0.1)
            float3 xformOp:scale = (0.065, 0.065, 0.12)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            color3f[] primvars:displayColor = [(0.1, 0.75, 0.85)]
        }

        def Xform "lidar_link"
        {
            double3 xformOp:translate = (0, 0, 0.19999999999999996)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Cylinder "LidarHousing"
            {
                uniform token axis = "Z"
                double radius = 0.055
                double height = 0.025
                double3 xformOp:translate = (0, 0, -0.0425)
                uniform token[] xformOpOrder = ["xformOp:translate"]
                color3f[] primvars:displayColor = [(0.1, 0.75, 0.85)]
            }

            def Camera "RtxLidar"
            {
                custom token cameraSensorType = "lidar"
                custom token sensorModelConfig = "Example_Rotary_2D"
                custom token rtxsensor:sensorModelConfig = "Example_Rotary_2D"
                token visibility = "invisible"
                float2 clippingRange = (0.01, 200)
            }
        }

        def Xform "front_camera_link"
        {
            double3 xformOp:translate = (0.39, 0, 0.075)
            float3 xformOp:rotateXYZ = (0, -5, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
            def Cube "RealSenseVisual"
            {
                double size = 1
                double3 xformOp:translate = (0, 0, 0)
                float3 xformOp:scale = (0.09, 0.025, 0.025)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                color3f[] primvars:displayColor = [(0.08, 0.08, 0.1)]
            }

            def Camera "Camera"
            {
                float focalLength = 18
                float2 clippingRange = (0.01, 20)
                double3 xformOp:translate = (0.046, 0, 0)
                float3 xformOp:rotateXYZ = (0, -90, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
            }
        }

        def Xform "rear_camera_link"
        {
            double3 xformOp:translate = (-0.39, 0, 0.075)
            float3 xformOp:rotateXYZ = (0, -5, 180)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
            def Cube "RealSenseVisual"
            {
                double size = 1
                double3 xformOp:translate = (0, 0, 0)
                float3 xformOp:scale = (0.09, 0.025, 0.025)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
